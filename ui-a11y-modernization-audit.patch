+
+/* ── Reduced Motion ─────────────────────────────────────────────
+   Users with vestibular disorders, migraine sensitivity, or anxiety
+   can be destabilized by continuous motion — respected here for every
+   named looping/animated class in this file, on top of the
+   motion-reduce: utility variants applied per-element in components.
+
+   Exception: .animate-somatic-breath drives the Module 2 4-7-8
+   breathing pacer (BiometricFloodingView) — its timing IS the clinical
+   exercise, so it stays running under reduced-motion rather than being
+   disabled outright. Its scale/glow range is reduced instead, keeping
+   the inhale/hold/exhale cadence intact with a gentler visual. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+
+  .animate-heart-pulse,
+  .bci-gradient-text {
+    animation: none !important;
+  }
+
+  .animate-somatic-breath {
+    animation-duration: 19s !important;
+    animation-iteration-count: infinite !important;
+    animation-name: breathCycleReduced !important;
+  }
+}
+
+@keyframes breathCycleReduced {
+  0% {
+    transform: scale(0.92);
+    opacity: 0.6;
+    box-shadow: 0 0 10px rgba(20, 184, 166, 0.15);
+  }
+  21% {
+    transform: scale(1.06);
+    opacity: 0.9;
+    box-shadow: 0 0 18px rgba(20, 184, 166, 0.3);
+  }
+  58% {
+    transform: scale(1.06);
+    opacity: 0.9;
+    box-shadow: 0 0 18px rgba(56, 189, 248, 0.3);
+  }
+  100% {
+    transform: scale(0.92);
+    opacity: 0.6;
+    box-shadow: 0 0 10px rgba(20, 184, 166, 0.15);
+  }
+}
